# === Зовнішній ШІ: Google Gemini API (CON-3, NFR-4) ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.1-flash-lite

# === База даних (CON-2, NFR-4) ===
# Основний варіант для хмарної PostgreSQL 16 (Neon.tech / Supabase):
# DATABASE_URL=postgresql://user:password@host/giftgenius?sslmode=require
# Локальний фолбек на SQLite для зручного запуску без хмарної БД:
DATABASE_URL=sqlite:///./giftgenius_local.db

# === Безпека та JWT (FR-6, NFR-4) ===
# Згенеруйте унікальний ключ: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_long_random_secret_key_for_local_dev
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# === Дозволені джерела для CORS (NFR-4) ===
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173